root   ::= "{" ws "\"consultas\"" ws ":" ws consultas-array ws "}" ws

consultas-array ::= "[" ws (consulta (ws "," ws consulta)*)? ws "]"

consulta ::= "{" ws "\"tool\"" ws ":" ws string (ws "," ws "\"params\"" ws ":" ws object)? ws "}"

object ::=
  "{" ws (
            string ws ":" ws value
    (ws "," ws string ws ":" ws value)*
  )? ws "}" ws

value  ::= object | array | string | number | ("true" | "false" | "null") ws

array  ::=
  "[" ws (
            value
    (ws "," ws value)*
  )? ws "]" ws

string ::=
  "\"" (
    [^"\\\x7F\x00-\x1F] |
    "\\" (["\\bfnrt] | "u" [0-9a-fA-F]{4})
  )* "\""

number ::= ("-"? ([0-9] | [1-9] [0-9]{1,15})) ("." [0-9]+)? ([eE] [-+]? [0-9]+)?

ws ::= [ \t\n]*
